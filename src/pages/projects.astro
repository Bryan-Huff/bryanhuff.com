---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects | Bryan Huff"
			description="Cybersecurity, homelab, and software projects by Bryan Huff."
		/>
	</head>

	<body>
		<Header />

		<main>
			<h1>Projects</h1>

			<p>
				A selection of my cybersecurity, homelab, infrastructure, and software projects.
			</p>

			<p>
      Each writeup covers the design decisions, the implementation, how I validated it, 
      and what went wrong along the way.
			</p>
		</main>

		<Footer />
	</body>
</html>
