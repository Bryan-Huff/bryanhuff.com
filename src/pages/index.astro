---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
>
	<section class="hero">
		<p class="eyebrow">Cybersecurity · Homelab · Technical Projects</p>

		<h1>Bryan Huff</h1>

		<p class="intro">
			I am building practical cybersecurity experience through hands-on infrastructure,
			security research, software projects, and technical documentation.
		</p>

		<div class="actions">
			<a class="primary" href="/projects">View Projects</a>
			<a href="/blog">Read the Blog</a>
		</div>
	</section>

	<section>
		<h2>What I am working on</h2>

		<p>
			My current work focuses on building and operating a segmented homelab,
			developing cybersecurity and systems-administration skills, and documenting
			the engineering decisions, implementation process, and lessons learned along the way.
		</p>

		<p>
			This site serves as a public record of that work, including project writeups,
			sanitized homelab documentation, security research, and software projects.
		</p>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 4rem 0 3rem;
	}

	.eyebrow {
		margin-bottom: 0.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		line-height: 1;
	}

	.intro {
		max-width: 44rem;
		margin-top: 1.5rem;
		font-size: 1.25rem;
		line-height: 1.6;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.actions a {
		text-decoration: none;
		font-weight: 700;
	}

	.actions .primary {
		padding: 0.75rem 1rem;
		border-radius: 0.4rem;
		background: var(--accent);
		color: white;
	}

	section + section {
		margin-top: 3rem;
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 2.5rem;
		}
	}
</style>
